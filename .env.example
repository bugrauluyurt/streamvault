# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streamvault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM Provider
# Options: "ollama" or "claude"
APP_LLM_PROVIDER=ollama

# Ollama settings (when using APP_LLM_PROVIDER=ollama)
# Production: http://localhost:11434 (host machine)
# Development: http://10.0.0.139:11434 (remote machine)
APP_OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:30b

# Worker Queue
QUEUE_WORKERS=2
QUEUE_POLL_INTERVAL=1.0

# External APIs
TMDB_API_KEY=changeme

# Shared storage
SHARED_DIR=/app/data/shared

# Data directories (for Docker volumes)
POSTGRES_DATA_DIR=./data/postgres
LOKI_DATA_DIR=./data/loki
GRAFANA_DATA_DIR=./data/grafana
